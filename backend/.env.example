# Settings for the backend. Copy this file to backend/.env and fill in the values you need. Never commit backend/.env
# (it is in .gitignore). The values below are placeholders: never put real secrets in this file.
#
# The backend reads backend/.env once, at startup (app/envfile.py, no extra package). Rules:
# - a variable already set in the shell wins over the file;
# - a line left empty here means "use the default", the same as leaving the line out;
# - after you change the file, restart the backend: settings are read only at startup;
# - lines that start with # are comments. Remove the # to use an optional setting.
# - keep secrets (SMTP_PASSWORD, GEMINI_API_KEY) in the shell, not in this file. Export them in the terminal that starts the backend.

# --- Mail: magic-link sign-in ---
# Magic-link sign-in mail. log = print the link to the log (default, local dev); smtp = send via SMTP_HOST.
# A real deployment must set smtp explicitly. Log mode prints live sign-in links.
MAIL_BACKEND=log
# SMTP server hostname. Required when MAIL_BACKEND=smtp; unset in log mode.
SMTP_HOST=
# SMTP port. 587 = submission with STARTTLS.
SMTP_PORT=587
# SMTP login name. Leave empty if the relay needs no login.
SMTP_USER=
# SMTP password or app password. Prefer the shell (export SMTP_PASSWORD=...). Never put it in a committed file.
SMTP_PASSWORD=
# Sender address on sign-in mail, e.g. no-reply@example.com.
SMTP_FROM=
# 1 = upgrade the connection with STARTTLS (default). 0 = plain SMTP, only for a trusted local relay.
SMTP_STARTTLS=1
# Origin users open in the browser, e.g. https://nav.example.org. Sign-in links are built from it.
# Required when MAIL_BACKEND=smtp (the backend will not start without it). Unset in log mode: the request's own origin is used.
PUBLIC_BASE_URL=
# Sign-in link lifetime in seconds (single use). Session lifetime in seconds (30 days).
AUTH_LINK_TTL_SEC=900
AUTH_SESSION_TTL_SEC=2592000
# Sign-in link requests allowed per window, per IP and per address (default 5 per 900 seconds). Past that: HTTP 429.
# AUTH_LINK_RATE_LIMIT=5
# AUTH_LINK_RATE_WINDOW_SEC=900

# --- Owners and moderation ---
# Owner accounts: comma-separated sign-in emails, e.g. you@example.org,second@example.org. An owner moderates
# walks (approve, reject, hide), manages buildings and map edits, resolves reports, and blocks contributors.
# Empty or unset = nobody is an owner, and the owner page cannot be opened (the backend logs a warning at startup).
# An owner signs in with the usual email link.
OWNER_EMAILS=
# Legacy shared secret for scripts, sent as the header X-Owner-Token. With it set:
#   - a request with the right X-Owner-Token counts as the owner for every owner route (no sign-in needed);
#   - every map-changing request must send either that header or an Authorization header (a sign-in session);
#     with neither it gets 401. The route then decides: owner routes need the owner, upload needs a contributor
#     session that is not blocked, and reads and the public routes (route, reports) stay open.
# The token is never accepted in a query string, a body, a cookie or as a Bearer session.
# Empty = the token is off, and owner routes need an owner sign-in. Use a long random value, e.g. from
# `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`. Anyone with this token is the owner.
OWNER_TOKEN=

# --- Optional settings (commented out: the defaults are used) ---
# Where buildings and the hosted-usage counter are kept. Default: backend/data. Tests never use it.
# DATA_DIR=/Users/you/waypoint-data
# Largest walk video in MiB (bigger uploads get 413).
# MAX_UPLOAD_MB=2048
# Local vision model for walks. Default gemma3:4b. gemma3:12b is slower and more accurate.
# GEMMA_MODEL=gemma3:4b
# Model choice for new walks: auto (hosted Gemini when a key is set, else Gemma), gemma (local only), hosted (Gemini only).
# VISION_PROVIDER=auto
# Gemini model for hosted walks. Must start with gemini. Used only with a key in the shell.
# HOSTED_MODEL=gemini-2.5-flash-lite
# Cost guard: most hosted Gemini requests per server per UTC day.
# HOSTED_MAX_CALLS_PER_DAY=5000
# On-device text reader: auto, vision (macOS), rapidocr (Linux, after uv sync --extra linux-ocr), or none.
# OCR_ENGINE=auto
