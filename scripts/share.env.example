# Copy this file to scripts/share.env and fill it in. scripts/share.env is gitignored.
# Do not commit real values. Only the names below are read by scripts/share.sh.
#
# Quick mode (no domain needed): leave TUNNEL_NAME and TUNNEL_HOSTNAME empty or commented out.
# Named mode (stable address): set both. Complete the one-time setup in scripts/README.md first.

# Name of the tunnel you created with: cloudflared tunnel create <name>
# TUNNEL_NAME=indoor-nav

# Public hostname routed to that tunnel, e.g. with: cloudflared tunnel route dns <name> <hostname>
# It must be a hostname on a domain you control in Cloudflare.
# TUNNEL_HOSTNAME=nav.example.com

# Optional owner key you choose yourself. Leave it unset to get a generated key, printed once on first start.
# If set, it must be at least 24 characters long, or the backend refuses to start.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_TOKEN=

# Do NOT set AUTH_REQUIRED=0 here. scripts/share.sh refuses to start when it is 0, because the tunnel
# would make an unprotected server public.
